{
  "ts": "2026-11-13T01:59:46.836912+00:00",
  "status": 200,
  "rules": [
    {
      "id": 1,
      "uid": "pharmago-http-5xx",
      "orgID": 1,
      "folderUID": "eg4469xpoz85cb",
      "ruleGroup": "pharmago-aiops",
      "title": "PharmaGo: tasa de errores HTTP 5xx",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "prometheus",
          "model": {
            "expr": "100 * sum by (service_name) (rate(pharmago_http_requests_total{job=\"otlp-collector\", status_code=~\"5..\", endpoint!~\"/health.*\"}[1m])) / sum by (service_name) (rate(pharmago_http_requests_total{job=\"otlp-collector\", endpoint!~\"/health.*\"}[1m])) and on (service_name) (sum by (service_name) (rate(pharmago_http_requests_total{job=\"otlp-collector\", endpoint!~\"/health.*\"}[1m])) > 0.1)",
            "instant": true,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "range": false,
            "refId": "A"
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    5
                  ],
                  "type": "gt"
                }
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "expression": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "threshold"
          }
        }
      ],
      "updated": "2026-11-13T01:52:56Z",
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "30s",
      "annotations": {
        "description": "Origen: pharmago_http_requests_total (OTLP). Ventana 1m, sin /health, con tráfico mínimo de 0,1 req/s. Sin tráfico = OK.",
        "summary": "{{ $labels.service_name }} responde 5xx en {{ $values.A.Value | printf \"%.1f\" }}% de las solicitudes"
      },
      "labels": {
        "severity": "critical",
        "team": "pharmago"
      },
      "provenance": "file",
      "isPaused": false,
      "notification_settings": null
    },
    {
      "id": 2,
      "uid": "pharmago-http-p95",
      "orgID": 1,
      "folderUID": "eg4469xpoz85cb",
      "ruleGroup": "pharmago-aiops",
      "title": "PharmaGo: latencia p95 HTTP alta",
      "condition": "C",
