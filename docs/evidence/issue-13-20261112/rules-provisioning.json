      "labels": {
        "severity": "warning",
        "team": "pharmago"
      },
      "provenance": "file",
      "isPaused": false,
      "notification_settings": null
    },
    {
      "id": 3,
      "uid": "pharmago-pod-cpu",
      "orgID": 1,
      "folderUID": "eg4469xpoz85cb",
      "ruleGroup": "pharmago-aiops",
      "title": "PharmaGo: CPU de Pod cerca del límite",
      "condition": "C",
      "data": [
