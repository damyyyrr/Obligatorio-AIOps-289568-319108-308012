          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    80
                  ],
                  "type": "gt"
                }
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "expression": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "threshold"
          }
        }
      ],
      "updated": "2026-11-13T01:52:56Z",
      "noDataState": "NoData",
      "execErrState": "Error",
      "for": "1m",
      "annotations": {
        "description": "Origen: cAdvisor (kubelet). cgroup del Pod (container vacío, válido en Docker y containerd): uso de CPU 1m frente a la suma de resources.limits.cpu. NoData indica que falló el scrape de cAdvisor.",
        "summary": "{{ $labels.pod }} usa {{ $values.A.Value | printf \"%.0f\" }}% de su límite de CPU"
